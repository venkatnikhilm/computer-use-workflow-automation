{
  "name": "capability-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx demo/server.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "discover:workflow": "tsx src/cli.ts discover-workflow",
    "replay:workflow": "tsx src/cli.ts replay-workflow",
    "verify:workflows": "tsx scripts/verify-workflows.ts",
    "verify:contact": "tsx scripts/verify-contact.ts",
    "verify:capability": "tsx scripts/verify-capability.ts",
    "verify:tenants": "tsx scripts/verify-tenants.ts",
    "verify:legacy": "tsx scripts/verify-legacy.ts",
    "api": "tsx src/api-cli.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "demo:inventory": "tsx demo/inventory.ts",
    "verify:generalization": "tsx scripts/verify-generalization.ts",
    "verify:targeting": "tsx --test tests/targeting.test.ts"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
