# Use a Google AI Studio project on the free tier with paid billing disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEMO_URL=http://127.0.0.1:4173
# HEADED=1 enables the visible browser and real operator handoff.
HEADED=0
# Per-run limits, not a guarantee of project-wide quota availability.
MODEL_MAX_CALLS=6
MODEL_MIN_INTERVAL_MS=15000
MODEL_MAX_RETRIES=0
MODEL_TIMEOUT_MS=30000
